# 이 파일은 "어떤 이름으로 키를 넣는지" 보여주는 예시입니다. 실제 키는 넣지 마세요.
# 서버에서는 이 파일을 복사해 .env 를 만들고, 그 안에만 실제 값을 넣습니다.

# 앱 로그인 비밀번호 (비워두면 로그인 없이 열림 — 개발용으로만)
APP_PASSWORD=

# 로그인 유지용 임의 문자열 (서버 설정 때 자동 생성 안내)
APP_SECRET=

# 시세 공급원: sample(연습용 데이터) / kiwoom(2단계에서 추가)
DATA_SOURCE=sample

# 키움 REST API (2단계) — 조회 전용
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
